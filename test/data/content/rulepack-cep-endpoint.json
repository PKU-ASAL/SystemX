{
  "api_version": "sysarmor.content/v1",
  "kind": "rulepack",
  "metadata": {
    "id": "rulepack:cep-endpoint",
    "version": "v1"
  },
  "spec": {
    "rulesets": [
      {
        "id": "ruleset:cep-endpoint",
        "version": "v1",
        "rules": [
          {
            "rule_id": "download_by_lolbin",
            "version": 1,
            "severity": "medium",
            "runtime": {
              "type": "builtin",
              "entrypoint": "builtin.download_by_lolbin"
            },
            "requires": {
              "events": [
                {
                  "behavior": "network.connect",
                  "fields": ["socket.addr", "socket.port", "process.binary", "process.argv", "lineage_id"]
                }
              ],
              "ioc": {
                "optional": ["ioc:c2-ip-feed", "ioc:c2-download-port-feed"]
              }
            }
          },
          {
            "rule_id": "payload_dropped",
            "version": 1,
            "severity": "high",
            "runtime": {
              "type": "builtin",
              "entrypoint": "builtin.payload_dropped"
            },
            "requires": {
              "events": [
                {
                  "behavior": "file.write",
                  "fields": ["file.path", "process.binary", "process.argv", "lineage_id"]
                },
                {
                  "behavior": "file.chmod",
                  "fields": ["file.path", "process.binary", "process.argv", "lineage_id"]
                }
              ],
              "context": {
                "optional": ["ctx:payload-path-prefixes"]
              }
            }
          },
          {
            "rule_id": "reverse_shell_pattern",
            "version": 1,
            "severity": "critical",
            "runtime": {
              "type": "builtin",
              "entrypoint": "builtin.reverse_shell_pattern"
            },
            "requires": {
              "events": [
                {
                  "behavior": "process.exec",
                  "fields": ["process.binary", "process.argv", "parent.stable_id", "lineage_id"]
                },
                {
                  "behavior": "network.connect",
                  "fields": ["socket.addr", "socket.port", "process.binary", "process.argv", "lineage_id"]
                }
              ],
              "ioc": {
                "optional": ["ioc:c2-ip-feed", "ioc:c2-control-port-feed"]
              }
            },
            "output": {
              "response_intent": {
                "action": "collect_evidence",
                "confidence": 80,
                "reason": "terminal endpoint reverse shell pattern"
              }
            }
          },
          {
            "rule_id": "suspicious_exec_connect",
            "version": 1,
            "severity": "high",
            "runtime": {
              "type": "builtin",
              "entrypoint": "builtin.suspicious_exec_connect"
            },
            "requires": {
              "events": [
                {
                  "behavior": "process.exec",
                  "fields": ["process.binary", "process.argv", "parent.stable_id", "lineage_id"]
                },
                {
                  "behavior": "network.connect",
                  "fields": ["socket.addr", "socket.port", "process.binary", "process.argv", "lineage_id"]
                }
              ],
              "context": {
                "optional": ["ctx:payload-path-prefixes"]
              },
              "ioc": {
                "optional": ["ioc:c2-ip-feed", "ioc:c2-control-port-feed"]
              }
            }
          },
          {
            "rule_id": "payload_lifecycle",
            "version": 1,
            "severity": "high",
            "runtime": {
              "type": "builtin",
              "entrypoint": "builtin.payload_lifecycle"
            },
            "requires": {
              "events": [
                {
                  "behavior": "file.write",
                  "fields": ["file.path", "process.binary", "process.argv", "lineage_id"]
                },
                {
                  "behavior": "process.exec",
                  "fields": ["process.binary", "process.argv", "parent.stable_id", "lineage_id"]
                },
                {
                  "behavior": "network.connect",
                  "fields": ["socket.addr", "socket.port", "process.binary", "process.argv", "lineage_id"]
                }
              ],
              "context": {
                "optional": ["ctx:payload-path-prefixes"]
              },
              "ioc": {
                "optional": ["ioc:c2-ip-feed", "ioc:c2-control-port-feed"]
              }
            }
          }
        ]
      }
    ]
  }
}
