{
  "policy_id": "edr-balanced-linux",
  "version": 1,
  "behaviors": [
    {
      "id": "process.exec",
      "enabled": true,
      "selectors": {
        "process": {
          "binary_prefixes": [
            "/tmp/",
            "/dev/shm/",
            "/var/tmp/",
            "/var/lib/app/plugins/",
            "/bin/sh",
            "/bin/bash",
            "/usr/bin/sh",
            "/usr/bin/bash",
            "/usr/bin/curl",
            "/usr/bin/wget",
            "/usr/bin/python",
            "/usr/bin/perl",
            "/usr/bin/nc",
            "/usr/bin/socat"
          ]
        }
      }
    },
    {
      "id": "network.connect",
      "enabled": true,
      "selectors": {
        "process": {
          "binary_prefixes": [
            "/tmp/",
            "/dev/shm/",
            "/var/tmp/",
            "/var/lib/app/plugins/",
            "/bin/sh",
            "/bin/bash",
            "/usr/bin/sh",
            "/usr/bin/bash",
            "/usr/bin/curl",
            "/usr/bin/wget",
            "/usr/bin/python",
            "/usr/bin/perl",
            "/usr/bin/nc",
            "/usr/bin/socat"
          ]
        },
        "socket": {
          "families": ["AF_INET", "AF_INET6"],
          "addr_refs": ["ioc:c2-ip-feed"],
          "port_refs": ["ioc:c2-port-feed"]
        }
      }
    },
    {
      "id": "file.write",
      "enabled": true,
      "selectors": {
        "process": {
          "binary_prefixes": [
            "/tmp/",
            "/dev/shm/",
            "/var/tmp/",
            "/var/lib/app/plugins/",
            "/bin/sh",
            "/bin/bash",
            "/usr/bin/sh",
            "/usr/bin/bash",
            "/usr/bin/curl",
            "/usr/bin/wget",
            "/usr/bin/python",
            "/usr/bin/perl",
            "/usr/bin/chmod",
            "/usr/bin/tee"
          ]
        },
        "file": {
          "prefix_refs": ["ctx:payload-path-prefixes", "ctx:persistence-path-prefixes"]
        }
      }
    },
    {
      "id": "file.chmod",
      "enabled": true,
      "selectors": {
        "process": {
          "binary_prefixes": [
            "/tmp/",
            "/dev/shm/",
            "/var/tmp/",
            "/var/lib/app/plugins/",
            "/bin/sh",
            "/bin/bash",
            "/usr/bin/sh",
            "/usr/bin/bash",
            "/usr/bin/curl",
            "/usr/bin/wget",
            "/usr/bin/python",
            "/usr/bin/perl",
            "/usr/bin/chmod",
            "/usr/bin/tee"
          ]
        },
        "file": {
          "prefix_refs": ["ctx:payload-path-prefixes", "ctx:persistence-path-prefixes"]
        }
      }
    }
  ],
  "scope_type": "host",
  "observe_only": true
}
