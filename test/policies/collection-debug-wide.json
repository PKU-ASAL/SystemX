{
  "policy_id": "debug-wide-linux",
  "version": 1,
  "behaviors": [
    {
      "id": "process.exec",
      "enabled": true,
      "selectors": {
        "process": {
          "binary_prefixes": ["/bin/", "/usr/bin/", "/usr/local/bin/", "/sbin/", "/usr/sbin/", "/tmp/", "/dev/shm/", "/var/tmp/", "/var/lib/app/plugins/"]
        }
      }
    },
    {
      "id": "process.fork",
      "enabled": true,
      "selectors": {
        "process": {
          "binary_prefixes": ["/bin/", "/usr/bin/", "/usr/local/bin/", "/sbin/", "/usr/sbin/", "/tmp/", "/dev/shm/", "/var/tmp/", "/var/lib/app/plugins/"]
        }
      }
    },
    {
      "id": "process.exit",
      "enabled": true
    },
    {
      "id": "network.connect",
      "enabled": true,
      "selectors": {
        "socket": {
          "families": ["AF_INET", "AF_INET6"]
        }
      }
    },
    {
      "id": "file.open",
      "enabled": true,
      "selectors": {
        "file": {
          "prefixes": ["/tmp/", "/dev/shm/", "/var/tmp/", "/var/lib/app/plugins/", "/etc/", "/run/secrets/"]
        }
      }
    },
    {
      "id": "file.read",
      "enabled": true,
      "selectors": {
        "file": {
          "prefixes": ["/etc/", "/run/secrets/", "/tmp/sysarmor-workload-secrets/"]
        }
      }
    },
    {
      "id": "file.write",
      "enabled": true,
      "selectors": {
        "file": {
          "prefixes": ["/tmp/", "/dev/shm/", "/var/tmp/", "/var/lib/app/plugins/"]
        }
      }
    },
    {
      "id": "file.chmod",
      "enabled": true,
      "selectors": {
        "file": {
          "prefixes": ["/tmp/", "/dev/shm/", "/var/tmp/", "/var/lib/app/plugins/"]
        }
      }
    }
  ],
  "scope_type": "host",
  "observe_only": true
}
