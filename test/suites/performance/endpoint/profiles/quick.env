# Fast developer/CI smoke profile. It proves the benchmark wiring and keeps
# enough samples to catch obvious regressions, but it is not a final resource
# conclusion.
: "${SYSARMOR_BENCH_HOST_BASELINE_SECONDS:=0}"
: "${SYSARMOR_BENCH_AGENT_IDLE_SECONDS:=5}"
: "${SYSARMOR_BENCH_SENSOR_IDLE_SECONDS:=5}"
: "${SYSARMOR_BENCH_BASELINE_SECONDS:=3}"
: "${SYSARMOR_BENCH_SETTLE_SECONDS:=8}"
: "${SYSARMOR_BENCH_STEADY_SECONDS:=4}"
: "${SYSARMOR_BENCH_POLICY_SETTLE_SECONDS:=10}"
: "${SYSARMOR_BENCH_WORKLOAD_SECONDS:=10}"
: "${SYSARMOR_BENCH_WORKLOAD_WARMUP_SECONDS:=2}"
: "${SYSARMOR_BENCH_WORKLOAD_REPEAT:=0}"
: "${SYSARMOR_BENCH_SCENARIO_OBSERVE_SECONDS:=5}"
: "${SYSARMOR_BENCH_COOLDOWN_SECONDS:=5}"
: "${SYSARMOR_RECORDER_SEMANTIC_INTERVAL:=10}"
: "${SYSARMOR_BENCH_PROFILE_AGENT:=0}"
