# Long endpoint resource profile. Use this for CPU/RSS conclusions on the
# single-node vm-endpoint environment. Profiling stays off by default because
# pprof collection changes the workload being measured.
: "${SYSARMOR_BENCH_HOST_BASELINE_SECONDS:=300}"
: "${SYSARMOR_BENCH_AGENT_IDLE_SECONDS:=600}"
: "${SYSARMOR_BENCH_SENSOR_IDLE_SECONDS:=600}"
: "${SYSARMOR_BENCH_BASELINE_SECONDS:=300}"
: "${SYSARMOR_BENCH_SETTLE_SECONDS:=300}"
: "${SYSARMOR_BENCH_STEADY_SECONDS:=600}"
: "${SYSARMOR_BENCH_POLICY_SETTLE_SECONDS:=120}"
: "${SYSARMOR_BENCH_WORKLOAD_SECONDS:=1800}"
: "${SYSARMOR_BENCH_WORKLOAD_WARMUP_SECONDS:=60}"
: "${SYSARMOR_BENCH_WORKLOAD_REPEAT:=0}"
: "${SYSARMOR_BENCH_SCENARIO_OBSERVE_SECONDS:=120}"
: "${SYSARMOR_BENCH_COOLDOWN_SECONDS:=300}"
: "${SYSARMOR_RECORDER_SEMANTIC_INTERVAL:=10}"
: "${SYSARMOR_BENCH_PROFILE_AGENT:=0}"
