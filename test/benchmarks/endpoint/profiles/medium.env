# Medium endpoint profile for daily detection + performance correlation.
# Single-policy duration is about 10 minutes. It is long enough to compare
# steady/workload/activity/persistence windows, but still short enough for iterative work.
: "${SYSARMOR_BENCH_HOST_BASELINE_SECONDS:=20}"
: "${SYSARMOR_BENCH_AGENT_IDLE_SECONDS:=30}"
: "${SYSARMOR_BENCH_SENSOR_IDLE_SECONDS:=30}"
: "${SYSARMOR_BENCH_BASELINE_SECONDS:=20}"
: "${SYSARMOR_BENCH_SETTLE_SECONDS:=30}"
: "${SYSARMOR_BENCH_STEADY_SECONDS:=90}"
: "${SYSARMOR_BENCH_POLICY_SETTLE_SECONDS:=30}"
: "${SYSARMOR_BENCH_WORKLOAD_SECONDS:=300}"
: "${SYSARMOR_BENCH_WORKLOAD_WARMUP_SECONDS:=10}"
: "${SYSARMOR_BENCH_WORKLOAD_REPEAT:=0}"
: "${SYSARMOR_BENCH_SCENARIO_OBSERVE_SECONDS:=60}"
: "${SYSARMOR_BENCH_COOLDOWN_SECONDS:=40}"
: "${SYSARMOR_RECORDER_SEMANTIC_INTERVAL:=10}"
: "${SYSARMOR_BENCH_PROFILE_AGENT:=0}"
